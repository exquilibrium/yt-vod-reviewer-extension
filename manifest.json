{
  "manifest_version": 3,
  "name": "YouTube VOD Review Panel",
  "version": "0.3.3",
  "description": "Load timestamped notes to navigate YouTube videos.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "VOD Notes",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}

